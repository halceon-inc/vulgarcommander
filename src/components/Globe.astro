---
import "mapbox-gl/dist/mapbox-gl.css";
---

<div id="globe-stage">
	<div id="globe"></div>
</div>

<style is:global>
	#globe-stage {
		position: fixed;
		inset: 0;
		background: #02040c;
	}

	#globe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		min-height: 100dvh;
	}

	#globe .mapboxgl-canvas {
		display: block;
		width: 100% !important;
		height: 100% !important;
	}

	.mapboxgl-ctrl-top-right {
		margin: 0.85rem 0.85rem 0 0;
	}

	.mapboxgl-ctrl-group {
		background: rgba(6, 10, 20, 0.58) !important;
		border: 1px solid rgba(255, 255, 255, 0.14) !important;
		border-radius: 12px !important;
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(14px);
		overflow: hidden;
	}

	.mapboxgl-ctrl-group button {
		width: 34px;
		height: 34px;
		background-color: transparent !important;
	}

	.mapboxgl-ctrl-group button + button {
		border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
	}

	.mapboxgl-ctrl-group button:hover {
		background-color: rgba(255, 255, 255, 0.08) !important;
	}

	.mapboxgl-ctrl-icon {
		filter: invert(1) brightness(1.15);
	}

	.mapboxgl-ctrl-attrib {
		background: rgba(2, 4, 12, 0.4) !important;
		color: rgba(232, 238, 247, 0.55) !important;
		border-radius: 6px 0 0 0;
	}

	.mapboxgl-ctrl-attrib a {
		color: rgba(232, 238, 247, 0.72) !important;
	}

	.mapboxgl-ctrl-bottom-left,
	.mapboxgl-ctrl-bottom-right {
		z-index: 5;
	}
</style>

<script>
	import mapboxgl from "mapbox-gl";
	import { IDLE_HINT, onReset, setHexOpen, setStatus, setVignetteClose } from "./globe-ui";

	type SavedLocation = {
		name: string;
		displayName: string;
		lat: number;
		lng: number;
		at: string;
	};

	const STORAGE_KEY = "map.selectedLocation";
	const HOME_KEY = "map.home";
	const OVERVIEW = { pitch: 0, bearing: 0 } as const;
	const RANGE_MILES = 100;
	const EARTH_MILES = 3958.7613;
	const SPIN_ZOOM_CUTOFF = 3;
	const LABEL_ZOOM = 3.7;
	// one full turn in about two minutes, same unhurried pace as the overview spin
	const ORBIT_DEGREES_PER_SECOND = 3;

	//smooth ease io for the whole flight, linear feels mechanical, and the built in fly ease flattens so long that the landing stalls
	function closeupEase(t: number) {
		return 0.5 - Math.cos(Math.PI * t) / 2;
	}

	const token = String(import.meta.env.PUBLIC_MAPBOX_TOKEN ?? "").trim();
	const el = document.getElementById("globe")!;
	const pin = document.getElementById("globe-pin");
	if (!(pin instanceof HTMLElement)) {
		throw new Error("Missing globe pin");
	}

	if (!token) {
		setStatus("Set PUBLIC_MAPBOX_TOKEN in .env and restart dev");
		throw new Error("Missing PUBLIC_MAPBOX_TOKEN");
	}

	mapboxgl.accessToken = token;

	let currentPlace: SavedLocation | null = null;
	let savedHome: SavedLocation | null = readHome();

	function readHome(): SavedLocation | null {
		try {
			const raw = localStorage.getItem(HOME_KEY);
			if (!raw) return null;
			const parsed = JSON.parse(raw) as SavedLocation;
			if (!parsed || typeof parsed.name !== "string" || !Number.isFinite(parsed.lat) || !Number.isFinite(parsed.lng)) return null;
			return parsed;
		} catch {
			return null;
		}
	}

	function placesMatch(a: SavedLocation, b: SavedLocation) {
		return Math.abs(a.lat - b.lat) < 0.0008 && Math.abs(a.lng - b.lng) < 0.0008;
	}

	function hideHomeHint() {
		const hint = document.getElementById("home-hint");
		const go = document.getElementById("home-go");
		if (hint instanceof HTMLElement) hint.hidden = true;
		if (go instanceof HTMLButtonElement) go.setAttribute("aria-expanded", "false");
	}

	function syncHomeControls() {
		const slot = document.getElementById("home-slot");
		const go = document.getElementById("home-go");
		const clear = document.getElementById("home-clear");
		const save = document.getElementById("home-save");
		const unset = savedHome == null;
		if (slot instanceof HTMLElement) slot.classList.toggle("is-unset", unset);
		if (clear instanceof HTMLButtonElement) clear.hidden = unset;
		if (go instanceof HTMLButtonElement) {
			if (savedHome) {
				hideHomeHint();
				go.title = savedHome.displayName || savedHome.name;
				go.setAttribute("aria-label", `Go to home, ${savedHome.name}`);
			} else {
				go.title = "How to set a home";
				go.setAttribute("aria-label", "Home is not set");
			}
		}
		if (save instanceof HTMLButtonElement) {
			const isHome = currentPlace != null && savedHome != null && placesMatch(currentPlace, savedHome);
			save.hidden = currentPlace == null;
			save.disabled = isHome;
			save.textContent = isHome ? "Your home" : "Set as home";
			save.title = isHome ? "This place is saved as home" : "Save this place as home";
		}
	}

	function saveLocation(loc: SavedLocation) {
		currentPlace = loc;
		localStorage.setItem(STORAGE_KEY, JSON.stringify(loc));
		setStatus(loc.name, true);
		syncHomeControls();
		const searchInput = document.getElementById("place-search-input");
		if (searchInput instanceof HTMLInputElement && document.activeElement !== searchInput) {
			searchInput.value = loc.name;
		}
		window.dispatchEvent(new CustomEvent("map:location", { detail: loc }));
	}

	function coordName(lat: number, lng: number) {
		return `${Math.abs(lat).toFixed(2)}°${lat >= 0 ? "N" : "S"}, ${Math.abs(lng).toFixed(2)}°${lng >= 0 ? "E" : "W"}`;
	}

	function bestName(
		result: { features?: Array<{ text?: string; place_name?: string }> },
		lat: number,
		lng: number,
	): string {
		const f = result.features?.[0];
		return f?.text || f?.place_name || coordName(lat, lng);
	}

	let abort: AbortController | null = null;

	async function reverseGeocode(lat: number, lng: number) {
		abort?.abort();
		abort = new AbortController();

		const url = new URL(
			`https://api.mapbox.com/geocoding/v5/mapbox.places/${lng},${lat}.json`,
		);
		url.searchParams.set("access_token", token);
		url.searchParams.set(
			"types",
			"place,locality,neighborhood,region,country",
		);
		url.searchParams.set("limit", "1");

		const res = await fetch(url, { signal: abort.signal });
		if (!res.ok) throw new Error(`Mapbox geocode ${res.status}`);
		return res.json();
	}

	function fitZoom() {
		const size = Math.min(el.clientWidth, el.clientHeight) || 680;
		return Math.min(2.05, Math.max(0.75, 1.86 + Math.log2(size / 680)));
	}

	// zoom where the 100-mile ring fills most of the shorter side of the screen
	function rangeZoom() {
		const size = Math.min(el.clientWidth, el.clientHeight) || 680;
		const diameterDeg = ((2 * RANGE_MILES) / EARTH_MILES) * (180 / Math.PI);
		const worldPx = ((size * 0.86) * 360) / diameterDeg;
		return Math.min(8.6, Math.max(4.8, Math.log2(worldPx / 512)));
	}

	function rangeRing(lat: number, lng: number): GeoJSON.Position[] {
		const steps = 96;
		const distance = RANGE_MILES / EARTH_MILES;
		const latRad = (lat * Math.PI) / 180;
		const lngRad = (lng * Math.PI) / 180;
		const ring: GeoJSON.Position[] = [];
		for (let i = 0; i <= steps; i++) {
			const bearing = (i / steps) * Math.PI * 2;
			const lat2 = Math.asin(
				Math.sin(latRad) * Math.cos(distance) + Math.cos(latRad) * Math.sin(distance) * Math.cos(bearing),
			);
			const lng2 =
				lngRad +
				Math.atan2(
					Math.sin(bearing) * Math.sin(distance) * Math.cos(latRad),
					Math.cos(distance) - Math.sin(latRad) * Math.sin(lat2),
				);
			ring.push([(lng2 * 180) / Math.PI, (lat2 * 180) / Math.PI]);
		}
		return ring;
	}

	const emptyRange: GeoJSON.FeatureCollection = { type: "FeatureCollection", features: [] };
	let rangeFeature: GeoJSON.FeatureCollection = emptyRange;
	let closeZoom = rangeZoom();

	function syncRange() {
		const source = map.getSource("range");
		if (source && source.type === "geojson") source.setData(rangeFeature);
	}

	function showRange(lat: number, lng: number) {
		rangeFeature = {
			type: "FeatureCollection",
			features: [
				{
					type: "Feature",
					properties: {},
					geometry: { type: "Polygon", coordinates: [rangeRing(lat, lng)] },
				},
			],
		};
		syncRange();
	}

	function hideRange() {
		rangeFeature = emptyRange;
		syncRange();
	}

	const map = new mapboxgl.Map({
		container: el,
		accessToken: token,
		style: "mapbox://styles/mapbox/satellite-streets-v12",
		projection: "globe",
		center: [18, 14],
		zoom: fitZoom(),
		pitch: OVERVIEW.pitch,
		bearing: OVERVIEW.bearing,
		attributionControl: true,
		antialias: true,
		failIfMajorPerformanceCaveat: false,
	});

	map.addControl(
		new mapboxgl.NavigationControl({ visualizePitch: true }),
		"top-right",
	);

	map.on("error", (e) => {
		console.error("[mapbox]", e.error);
		setStatus("The map had trouble loading. Check your connection and refresh the page.");
	});

	let awaitingCloseup = false;
	let hexPinned = false;

	function releaseHex() {
		if (!hexPinned) return;
		hexPinned = false;
		marker.remove();
		hideRange();
		setHexOpen(false);
		currentPlace = null;
		syncHomeControls();
		closeSearchList();
		const searchBox = document.getElementById("place-search-input");
		if (searchBox instanceof HTMLInputElement && document.activeElement !== searchBox) {
			searchBox.value = "";
		}
		setStatus(IDLE_HINT, false);
	}

	const marker = new mapboxgl.Marker({ element: pin, anchor: "bottom" });

	let userInteracting = false;
	let spinEnabled = true;
	let spinResume = 0;
	let programmaticMove = false;
	let orbiting = false;
	let pendingBearingReset = false;
	let bearingResetting = false;
	let orbitHomeBearing: number | null = null;

	function clearOrbit() {
		orbiting = false;
		pendingBearingReset = false;
		bearingResetting = false;
		orbitHomeBearing = null;
		window.clearTimeout(spinResume);
	}

	function spinGlobe() {
		if (bearingResetting || !spinEnabled || userInteracting || map.getZoom() >= SPIN_ZOOM_CUTOFF) {
			return;
		}
		const distancePerSecond = 360 / 140;
		const center = map.getCenter();
		center.lng -= distancePerSecond;
		programmaticMove = true;
		map.easeTo({ center, duration: 1000, easing: (n) => n });
	}

	function orbitPoint() {
		if (!orbiting || userInteracting || bearingResetting || pendingBearingReset) return;
		programmaticMove = true;
		map.easeTo({
			bearing: map.getBearing() + ORBIT_DEGREES_PER_SECOND,
			duration: 1000,
			easing: (n) => n,
		});
	}

	function resetOrbitBearing() {
		pendingBearingReset = false;
		orbiting = false;
		const home = orbitHomeBearing;
		orbitHomeBearing = null;
		if (home == null) return;
		const delta = ((map.getBearing() - home + 540) % 360) - 180;
		if (Math.abs(delta) < 0.75) return;
		bearingResetting = true;
		programmaticMove = true;
		map.easeTo({ bearing: home, duration: 900, easing: closeupEase });
	}

	function settleAfterGesture() {
		userInteracting = false;
		if (pendingBearingReset) resetOrbitBearing();
		else if (orbiting) orbitPoint();
		else spinGlobe();
	}

	let atmosphere: "space" | "ground" = "space";
	let labelsOn = true;
	let sunLng = Number.NaN;
	let sunClose = false;

	function wrap360(deg: number) {
		return ((deg % 360) + 360) % 360;
	}

	function aimSun(force = false) {
		const lng = map.getCenter().lng;
		const close = map.getZoom() >= 5;
		if (!force && close === sunClose && Math.abs(lng - sunLng) < 8) return;
		sunLng = lng;
		sunClose = close;
		//key light sits just west of the camera target so the facing disk stays lit as the globe spins with a soft falloff toward the limb
		map.setLights([
			{
				id: "ambient",
				type: "ambient",
				properties: {
					color: "#f7f5f2",
					intensity: close ? 0.5 : 0.4,
				},
			},
			{
				id: "sun",
				type: "directional",
				properties: {
					color: "#fffaf4",
					intensity: close ? 0.48 : 0.5,
					direction: [wrap360(lng - (close ? 16 : 32)), close ? 48 : 30],
					"cast-shadows": false,
				},
			},
		]);
	}

	function syncAtmosphere() {
		const next = map.getZoom() >= 4.2 ? "ground" : "space";
		setVignetteClose(next === "ground");
		if (next === atmosphere) return;
		atmosphere = next;
		if (next === "space") {
			map.setFog({
				color: "rgb(168, 204, 234)",
				"high-color": "rgb(36, 92, 214)",
				"horizon-blend": 0.055,
				"space-color": "rgb(2, 4, 12)",
				"star-intensity": 0.85,
			});
			return;
		}
		map.setFog({
			range: [1.2, 10],
			color: "rgb(206, 220, 232)",
			"high-color": "rgb(126, 164, 210)",
			"horizon-blend": 0.14,
			"space-color": "rgb(168, 190, 214)",
			"star-intensity": 0,
		});
	}

	function syncLabels() {
		const on = map.getZoom() >= LABEL_ZOOM;
		if (on === labelsOn) return;
		labelsOn = on;
		for (const layer of map.getStyle()?.layers ?? []) {
			if (layer.type !== "symbol") continue;
			map.setLayoutProperty(layer.id, "visibility", on ? "visible" : "none");
		}
	}

	function gradeImagery() {
		for (const layer of map.getStyle()?.layers ?? []) {
			if (layer.type !== "raster") continue;
			map.setPaintProperty(layer.id, "raster-saturation", 0.08);
			map.setPaintProperty(layer.id, "raster-contrast", 0.06);
			map.setPaintProperty(layer.id, "raster-brightness-min", 0.03);
		}
	}

	map.on("style.load", () => {
		if (!map.getSource("mapbox-dem")) {
			map.addSource("mapbox-dem", {
				type: "raster-dem",
				url: "mapbox://mapbox.mapbox-terrain-dem-v1",
				tileSize: 512,
				maxzoom: 14,
			});
		}
		map.setTerrain({
			source: "mapbox-dem",
			exaggeration: [
				"interpolate",
				["linear"],
				["zoom"],
				1.5,
				0.45,
				5,
				1.15,
				12,
				1.45,
			],
		});
		if (!map.getSource("range")) {
			map.addSource("range", { type: "geojson", data: rangeFeature });
			map.addLayer({
				id: "range-fill",
				type: "fill",
				source: "range",
				paint: { "fill-color": "#e85d4c", "fill-opacity": 0.18 },
			});
			map.addLayer({
				id: "range-line",
				type: "line",
				source: "range",
				paint: {
					"line-color": "#ffffff",
					"line-width": 2.5,
					"line-opacity": 0.95,
				},
			});
		} else {
			syncRange();
		}
		atmosphere = "ground";
		aimSun(true);
		syncAtmosphere();
		gradeImagery();
		syncLabels();
		map.resize();
	});

	// The spin is one long ease. A scroll during that ease gets applied, then the
	// next animation frame puts the zoom back, so the wheel does nothing.
	map.getCanvasContainer().addEventListener(
		"wheel",
		() => {
			userInteracting = true;
			window.clearTimeout(spinResume);
			if (orbiting || orbitHomeBearing != null) {
				orbiting = false;
				pendingBearingReset = true;
				releaseHex();
			}
			if (map.isEasing()) map.stop();
			spinResume = window.setTimeout(settleAfterGesture, 200);
		},
		{ capture: true, passive: true },
	);

	map.on("mousedown", () => {
		userInteracting = true;
	});
	map.on("dragstart", (event) => {
		userInteracting = true;
		spinEnabled = false;
		window.clearTimeout(spinResume);
		releaseHex();
		const pointer = event.originalEvent;
		const rotating = pointer instanceof MouseEvent && (pointer.button === 2 || pointer.ctrlKey || pointer.metaKey);
		if (orbiting || orbitHomeBearing != null) {
			orbiting = false;
			if (rotating) {
				pendingBearingReset = false;
				orbitHomeBearing = null;
			} else {
				pendingBearingReset = true;
			}
		}
	});
	map.on("zoomstart", () => {
		if (programmaticMove || bearingResetting) return;
		if (!orbiting && orbitHomeBearing == null) return;
		orbiting = false;
		pendingBearingReset = true;
		releaseHex();
	});
	map.on("mouseup", () => {
		userInteracting = false;
		if (pendingBearingReset) {
			window.clearTimeout(spinResume);
			spinResume = window.setTimeout(settleAfterGesture, 60);
			return;
		}
		if (orbiting) orbitPoint();
		else spinGlobe();
	});
	map.on("touchend", () => {
		userInteracting = false;
		if (pendingBearingReset) {
			window.clearTimeout(spinResume);
			spinResume = window.setTimeout(settleAfterGesture, 60);
			return;
		}
		if (orbiting) orbitPoint();
		else spinGlobe();
	});
	map.on("movestart", () => {
		if (programmaticMove) return;
		releaseHex();
	});
	map.on("move", () => {
		aimSun();
		syncAtmosphere();
		syncLabels();
	});
	map.on("moveend", () => {
		const wasProgrammatic = programmaticMove;
		programmaticMove = false;
		if (bearingResetting && wasProgrammatic) {
			bearingResetting = false;
			return;
		}
		if (awaitingCloseup && map.getZoom() >= closeZoom - 0.45) {
			awaitingCloseup = false;
			hexPinned = true;
			setHexOpen(true);
			orbitHomeBearing = map.getBearing();
			orbiting = true;
			pendingBearingReset = false;
			if (!userInteracting) orbitPoint();
			return;
		}
		if (userInteracting || pendingBearingReset) return;
		if (orbiting) orbitPoint();
		else spinGlobe();
	});

	map.once("load", () => {
		map.resize();
		spinGlobe();
	});

	window.addEventListener("resize", () => {
		map.resize();
		if (spinEnabled && map.getZoom() < SPIN_ZOOM_CUTOFF) {
			map.jumpTo({ zoom: fitZoom() });
		}
	});

	function visitPlace(lat: number, lng: number, known?: { name: string; displayName: string }) {
		clearOrbit();
		spinEnabled = false;
		abort?.abort();
		marker.setLngLat([lng, lat]).addTo(map);
		showRange(lat, lng);
		hexPinned = false;
		setHexOpen(false);
		awaitingCloseup = true;
		closeZoom = rangeZoom();
		map.flyTo({
			center: [lng, lat],
			zoom: closeZoom,
			pitch: 46,
			bearing: -16,
			duration: 1900,
			curve: 1.35,
			easing: closeupEase,
			essential: true,
		});
		if (known) {
			saveLocation({ name: known.name, displayName: known.displayName, lat, lng, at: new Date().toISOString() });
			return;
		}
		setStatus("Finding this place…", true);
		void nameClickedPlace(lat, lng);
	}

	async function nameClickedPlace(lat: number, lng: number) {
		try {
			const result = await reverseGeocode(lat, lng);
			const name = bestName(result, lat, lng);
			saveLocation({
				name,
				displayName: result.features?.[0]?.place_name ?? name,
				lat,
				lng,
				at: new Date().toISOString(),
			});
		} catch (err) {
			if ((err as Error).name === "AbortError") return;
			console.error(err);
			const name = coordName(lat, lng);
			saveLocation({ name, displayName: name, lat, lng, at: new Date().toISOString() });
		}
	}

	map.on("click", (e) => {
		visitPlace(e.lngLat.lat, e.lngLat.lng);
	});

	type SearchHit = { name: string; displayName: string; lat: number; lng: number };

	const searchForm = document.getElementById("place-search");
	const searchInput = document.getElementById("place-search-input");
	const searchList = document.getElementById("place-search-results");
	let searchHits: SearchHit[] = [];
	let searchIndex = -1;
	let searchTimer = 0;
	let searchAbort: AbortController | null = null;
	let searchSeq = 0;

	function closeSearchList() {
		if (!(searchList instanceof HTMLElement)) return;
		searchList.hidden = true;
		searchList.replaceChildren();
		searchHits = [];
		searchIndex = -1;
	}

	function paintSearchList() {
		if (!(searchList instanceof HTMLElement)) return;
		searchList.replaceChildren();
		if (searchHits.length === 0) {
			const empty = document.createElement("li");
			empty.className = "place-empty";
			empty.textContent = "No places found";
			searchList.append(empty);
			searchList.hidden = false;
			return;
		}
		searchHits.forEach((hit, index) => {
			const item = document.createElement("li");
			const button = document.createElement("button");
			button.type = "button";
			button.setAttribute("role", "option");
			button.setAttribute("aria-selected", String(index === searchIndex));
			button.textContent = hit.displayName;
			button.addEventListener("mousedown", (event) => {
				event.preventDefault();
			});
			button.addEventListener("click", () => {
				chooseSearchHit(index);
			});
			item.append(button);
			searchList.append(item);
		});
		searchList.hidden = false;
	}

	function chooseSearchHit(index: number) {
		const hit = searchHits[index];
		if (!hit || !(searchInput instanceof HTMLInputElement)) return;
		searchInput.value = hit.name;
		closeSearchList();
		searchInput.blur();
		visitPlace(hit.lat, hit.lng, { name: hit.name, displayName: hit.displayName });
	}

	async function runPlaceSearch(query: string) {
		searchAbort?.abort();
		const seq = ++searchSeq;
		const ctrl = new AbortController();
		searchAbort = ctrl;
		const url = new URL(`https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(query)}.json`);
		url.searchParams.set("access_token", token);
		url.searchParams.set("autocomplete", "true");
		url.searchParams.set("limit", "5");
		const center = map.getCenter();
		url.searchParams.set("proximity", `${center.lng},${center.lat}`);
		try {
			const res = await fetch(url, { signal: ctrl.signal });
			if (!res.ok) throw new Error(`Mapbox geocode ${res.status}`);
			const body = (await res.json()) as {
				features?: Array<{ text?: string; place_name?: string; center?: [number, number] }>;
			};
			if (seq !== searchSeq) return;
			searchHits = [];
			for (const feature of body.features ?? []) {
				const lng = feature.center?.[0];
				const lat = feature.center?.[1];
				if (lat == null || lng == null) continue;
				const name = feature.text || feature.place_name || coordName(lat, lng);
				searchHits.push({
					name,
					displayName: feature.place_name || name,
					lat,
					lng,
				});
			}
			searchIndex = searchHits.length > 0 ? 0 : -1;
			paintSearchList();
		} catch (err) {
			if ((err as Error).name === "AbortError" || seq !== searchSeq) return;
			console.error(err);
			searchHits = [];
			searchIndex = -1;
			paintSearchList();
		}
	}

	if (searchForm instanceof HTMLFormElement && searchInput instanceof HTMLInputElement && searchList instanceof HTMLElement) {
		searchForm.addEventListener("submit", (event) => {
			event.preventDefault();
			if (searchIndex >= 0) chooseSearchHit(searchIndex);
			else if (searchHits.length > 0) chooseSearchHit(0);
		});
		searchInput.addEventListener("input", () => {
			window.clearTimeout(searchTimer);
			const query = searchInput.value.trim();
			if (query.length < 2) {
				searchAbort?.abort();
				closeSearchList();
				return;
			}
			searchTimer = window.setTimeout(() => {
				void runPlaceSearch(query);
			}, 180);
		});
		searchInput.addEventListener("keydown", (event) => {
			if (event.key === "ArrowDown" || event.key === "ArrowUp") {
				if (searchList.hidden || searchHits.length === 0) return;
				event.preventDefault();
				const step = event.key === "ArrowDown" ? 1 : -1;
				searchIndex = (searchIndex + step + searchHits.length) % searchHits.length;
				paintSearchList();
				return;
			}
			if (event.key === "Escape") {
				event.stopPropagation();
				if (!searchList.hidden) closeSearchList();
				else searchInput.blur();
			}
		});
		searchInput.addEventListener("focus", () => {
			if (searchHits.length > 0 && searchInput.value.trim().length >= 2) paintSearchList();
		});
	}

	function bearingFromNorth() {
		return Math.abs(((map.getBearing() + 540) % 360) - 180);
	}

	function inDefaultView() {
		return (
			!hexPinned &&
			!awaitingCloseup &&
			Math.abs(map.getZoom() - fitZoom()) < 0.15 &&
			Math.abs(map.getPitch() - OVERVIEW.pitch) < 1 &&
			bearingFromNorth() < 1
		);
	}

	function resetView() {
		clearOrbit();
		marker.remove();
		hideRange();
		awaitingCloseup = false;
		hexPinned = false;
		currentPlace = null;
		syncHomeControls();
		setHexOpen(false);
		closeSearchList();
		if (searchInput instanceof HTMLInputElement) searchInput.value = "";
		setStatus(IDLE_HINT, false);
		spinEnabled = true;
		// Already the spinning overview. A flyTo here only cancels that spin.
		if (inDefaultView()) {
			if (!map.isEasing()) spinGlobe();
			return;
		}
		const center = map.getCenter();
		// Keep the stop() inside flyTo from chaining a new spin before the flight starts.
		spinEnabled = false;
		programmaticMove = true;
		map.flyTo({
			center: [center.lng, center.lat],
			zoom: fitZoom(),
			pitch: OVERVIEW.pitch,
			bearing: OVERVIEW.bearing,
			duration: 1800,
			essential: true,
		});
		const resumeSpin = () => {
			spinEnabled = true;
			programmaticMove = false;
			spinGlobe();
		};
		if (map.isMoving() || map.isEasing()) map.once("moveend", resumeSpin);
		else resumeSpin();
	}

	onReset(resetView);

	document.getElementById("home-save")?.addEventListener("click", () => {
		if (!currentPlace) return;
		savedHome = currentPlace;
		localStorage.setItem(HOME_KEY, JSON.stringify(savedHome));
		syncHomeControls();
	});

	document.getElementById("home-go")?.addEventListener("click", () => {
		if (savedHome) {
			visitPlace(savedHome.lat, savedHome.lng, {
				name: savedHome.name,
				displayName: savedHome.displayName || savedHome.name,
			});
			return;
		}
		const hint = document.getElementById("home-hint");
		const go = document.getElementById("home-go");
		if (!(hint instanceof HTMLElement) || !(go instanceof HTMLButtonElement)) return;
		hint.hidden = !hint.hidden;
		go.setAttribute("aria-expanded", String(!hint.hidden));
	});

	document.getElementById("home-clear")?.addEventListener("click", () => {
		savedHome = null;
		localStorage.removeItem(HOME_KEY);
		hideHomeHint();
		syncHomeControls();
	});

	document.addEventListener("click", (event) => {
		const slot = document.getElementById("home-slot");
		if (slot instanceof HTMLElement && event.target instanceof Node && slot.contains(event.target)) return;
		hideHomeHint();
	});

	syncHomeControls();

	window.addEventListener("map:pane", () => {
		closeSearchList();
		hideHomeHint();
		if (searchInput instanceof HTMLInputElement) searchInput.blur();
	});
</script>
