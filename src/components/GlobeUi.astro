				<div class="cal-toggle" role="group" aria-label="Colour cells by">
					<button type="button" data-mode="count" aria-pressed="true" title="Colour by how many fire days each week had">How many fires</button>
					<button type="button" data-mode="departure" aria-pressed="false" title="Colour by whether each week was busier or quieter than that same week in other years">Compared to normal</button>
				</div>
				<button type="button" id="calendar-frame-close" class="chart-close" aria-label="Close">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"></path></svg>
				</button>
