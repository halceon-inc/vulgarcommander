		border-radius: 14px;
	}

	.ask-log {
		flex: 1;
		min-height: 0;
		overflow: auto;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.1rem 1.1rem 0.9rem;
		scrollbar-width: thin;
		scrollbar-color: #3e4b53 transparent;
	}

	.ask-intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: auto 0;
		padding: 1rem 1.5rem 0.25rem;
		text-align: center;
	}

	.ask-intro h3 {
		margin: 0.9rem 0 0.35rem;
		color: #e8edef;
		font: 650 17px/1.2 ui-sans-serif, system-ui, sans-serif;
	}

	.ask-intro p {
		max-width: 38ch;
		margin: 0;
		color: #84939c;
		font: 450 13.5px/1.5 ui-sans-serif, system-ui, sans-serif;
	}

	/* outer hex is the orange edge, ::before is the fill, ::after the core */
	.ask-avatar {
		position: relative;
		flex: none;
		width: 22px;
		height: 25.4px;
		margin-top: 0.1rem;
		background: #d95926;
		clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
	}

	.ask-avatar::before,
	.ask-avatar::after {
		content: "";
		position: absolute;
		clip-path: inherit;
	}

	.ask-avatar::before {
		inset: 1.5px;
		background: linear-gradient(165deg, #2a2420, #13110f);
	}

	.ask-avatar::after {
		inset: 34% 32%;
		background: #ef8d58;
	}

	.ask-avatar--lg {
		width: 44px;
		height: 50.8px;
		margin: 0;
	}

	.ask-avatar--lg::before {
		inset: 2px;
	}

	.ask-row {
		display: flex;
		gap: 0.65rem;
		animation: ask-in 0.25s ease both;
	}

	.ask-row--user {
		justify-content: flex-end;
	}

	.ask-msg {
		max-width: 85%;
		margin: 0;
		color: #cfd8dc;
		font: 450 14.5px/1.55 ui-sans-serif, system-ui, sans-serif;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.ask-msg b {
		color: #fff;
		font-weight: 650;
		background: linear-gradient(transparent 62%, rgba(217, 89, 38, 0.38) 62%);
		padding: 0 0.1em;
		border-radius: 2px;
	}

	.ask-msg--assistant {
		padding-top: 0.15rem;
	}

	.ask-msg--user {
		padding: 0.55rem 0.85rem;
		background: rgba(217, 89, 38, 0.14);
		border: 1px solid rgba(217, 89, 38, 0.32);
		border-radius: 14px 14px 4px 14px;
		color: #f3e6de;
	}

	.ask-msg--error {
		padding: 0.5rem 0.75rem;
		background: rgba(230, 103, 103, 0.08);
		border: 1px solid rgba(230, 103, 103, 0.25);
		border-radius: 10px;
		color: #f6aaa7;
		font-size: 13.5px;
	}

	.ask-dots {
		display: inline-flex;
		gap: 4px;
		padding: 0.45rem 0;
	}

	.ask-dots i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #84939c;
		animation: ask-dot 1.1s ease-in-out infinite;
