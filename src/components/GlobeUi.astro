	/* outer hex is the orange edge, ::before is the fill, ::after the core */
	.ask-avatar {
		position: relative;
		flex: none;
		width: 22px;
		height: 25.4px;
		margin-top: 0.1rem;
		background: #d95926;
		clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
	}

	.ask-avatar::before,
	.ask-avatar::after {
		content: "";
		position: absolute;
		clip-path: inherit;
	}

	.ask-avatar::before {
		inset: 1.5px;
		background: linear-gradient(165deg, #2a2420, #13110f);
	}

	.ask-avatar::after {
		inset: 34% 32%;
		background: #ef8d58;
	}

	.ask-avatar--lg {
		width: 44px;
		height: 50.8px;
		margin: 0;
	}

	.ask-avatar--lg::before {
		inset: 2px;
	}

