		animation-delay: var(--d);
	}

	.calendar-host rect[data-bar] {
		transform-box: fill-box;
		transform-origin: left center;
		animation: grow-x 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--d);
	}

	.cal-clim {
		transform-box: fill-box;
		transform-origin: center bottom;
		animation: grow-y 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--d);
	}

	.ring-era {
		animation: fade 0.6s ease 0.9s both;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	@keyframes fade {
		from {
			opacity: 0;
		}
	}

	@keyframes pop {
		from {
			opacity: 0;
			transform: scale(0);
		}
	}

	@keyframes draw {
		from {
			stroke-dashoffset: 1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes grow-x {
		from {
			transform: scaleX(0);
		}
	}

	@keyframes grow-y {
		from {
			transform: scaleY(0);
		}
	}

	@keyframes mark-in {
		from {
			background-size: 0% 100%;
		}
	}

	@keyframes tip-in {
		from {
			opacity: 0;
			transform: translateY(3px);
		}
	}

	@keyframes shimmer {
		to {
			background-position: -200% 0;
		}
	}

	@keyframes ember {
		0% {
			box-shadow: 0 0 0 0 rgba(217, 89, 38, 0.6);
		}
		70%,
		100% {
			box-shadow: 0 0 0 7px rgba(217, 89, 38, 0);
		}
	}

	@keyframes pin-drop {
		0% {
			opacity: 0;
			transform: translateY(-28px) scale(0.7, 1.15);
		}
		60% {
			opacity: 1;
			transform: translateY(0) scale(1.12, 0.85);
		}
		80% {
			transform: translateY(-3px) scale(0.96, 1.04);
		}
		100% {
			transform: none;
		}
	}

	@keyframes pin-ping {
		0% {
			opacity: 0.9;
			transform: scale(0.4);
		}
		100% {
			opacity: 0;
			transform: scale(2.6);
		}
	}

	@keyframes hex-sheen {
		to {
			background-position: 0% 0;
		}
	}

	@keyframes hex-spin {
		to {
			--hex-angle: 360deg;
		}
	}

	@keyframes hex-float {
		50% {
			transform: translateY(-4px);
		}
	}

	@keyframes core-pulse {
		50% {
			opacity: 0.35;
			transform: scale(0.7);
		}
	}

	@keyframes icon-ring {
		50% {
			transform: scale(0.8);
		}
	}

	@keyframes icon-drift {
		from {
			transform: translateX(-1.5px);
		}
		to {
			transform: translateX(1.5px);
		}
	}

	@keyframes icon-bounce {
		0%,
		60%,
		100% {
			transform: translateY(0);
		}
		30% {
			transform: translateY(-2px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-delay: 0s !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>

<script>
	import { drawCalendar, type CalendarMode } from "./calendar-chart";
	import { drawDrift } from "./drift-chart";
	import { drawRace } from "./race-chart";
	import { drawSeam } from "./seam-chart";
	import { clearRingTip, drawRingChart } from "./ring-chart";
	import type { RingSeries } from "../lib/firms-db";
	import { requestReset, watchHex, watchStatus, watchVignette } from "./globe-ui";

	const vignette = document.getElementById("globe-vignette")!;
	const nameEl = document.getElementById("location-name")!;
	const resetBtn = document.getElementById("globe-reset") as HTMLButtonElement;
	const hexPanel = document.getElementById("hex-panel")!;
	const hexCells = [...hexPanel.querySelectorAll<HTMLElement>(".hex-cell")];
	const ringFrame = document.getElementById("ring-frame")!;
	const ringCard = ringFrame.querySelector<HTMLElement>(".chart-card")!;
	const ringHost = document.getElementById("ring-chart")!;
	const ringLegend = document.getElementById("ring-legend")!;
	const ringReadout = document.getElementById("ring-readout")!;
	const ringTitle = document.getElementById("ring-frame-title")!;
	const ringClose = document.getElementById("ring-frame-close") as HTMLButtonElement;
	const ringTip = document.getElementById("ring-tip")!;
	const ringButton = hexPanel.querySelector<HTMLButtonElement>("[data-graph='rings']")!;
	const calendarFrame = document.getElementById("calendar-frame")!;
	const calendarCard = calendarFrame.querySelector<HTMLElement>(".chart-card")!;
	const calendarHost = document.getElementById("calendar-chart")!;
	const calendarLegend = document.getElementById("calendar-legend")!;
	const calendarReadout = document.getElementById("calendar-readout")!;
	const calendarTable = document.getElementById("calendar-table")!;
	const calendarTitle = document.getElementById("calendar-frame-title")!;
	const calendarClose = document.getElementById("calendar-frame-close") as HTMLButtonElement;
	const calendarButton = hexPanel.querySelector<HTMLButtonElement>("[data-graph='calendar']")!;
	const calendarModes = [...calendarFrame.querySelectorAll<HTMLButtonElement>(".cal-toggle button")];
	const raceFrame = document.getElementById("race-frame")!;
	const raceCard = raceFrame.querySelector<HTMLElement>(".chart-card")!;
	const raceHost = document.getElementById("race-chart")!;
	const raceLegend = document.getElementById("race-legend")!;
	const raceReadout = document.getElementById("race-readout")!;
	const raceTitle = document.getElementById("race-frame-title")!;
	const raceClose = document.getElementById("race-frame-close") as HTMLButtonElement;
	const raceButton = hexPanel.querySelector<HTMLButtonElement>("[data-graph='race']")!;
	const driftFrame = document.getElementById("drift-frame")!;
	const driftCard = driftFrame.querySelector<HTMLElement>(".chart-card")!;
	const driftHost = document.getElementById("drift-chart")!;
	const driftLegend = document.getElementById("drift-legend")!;
	const driftReadout = document.getElementById("drift-readout")!;
	const driftTitle = document.getElementById("drift-frame-title")!;
	const driftClose = document.getElementById("drift-frame-close") as HTMLButtonElement;
	const driftButton = hexPanel.querySelector<HTMLButtonElement>("[data-graph='drift']")!;
	const seamFrame = document.getElementById("seam-frame")!;
	const seamCard = seamFrame.querySelector<HTMLElement>(".chart-card")!;
	const seamHost = document.getElementById("seam-chart")!;
	const seamScatter = document.getElementById("seam-scatter")!;
	const seamLegend = document.getElementById("seam-legend")!;
	const seamScatterLegend = document.getElementById("seam-scatter-legend")!;
	const seamReadout = document.getElementById("seam-readout")!;
	const seamTitle = document.getElementById("seam-frame-title")!;
	const seamClose = document.getElementById("seam-frame-close") as HTMLButtonElement;
	const seamButton = hexPanel.querySelector<HTMLButtonElement>("[data-graph='seam']")!;
	const askFrame = document.getElementById("ask-frame")!;
	const askCard = askFrame.querySelector<HTMLElement>(".chart-card")!;
	const askTitle = document.getElementById("ask-frame-title")!;
	const askClose = document.getElementById("ask-frame-close") as HTMLButtonElement;
	const askButton = hexPanel.querySelector<HTMLButtonElement>("[data-graph='ask']")!;
	const askLog = document.getElementById("ask-log")!;
	const askSuggestions = document.getElementById("ask-suggestions")!;
	const askForm = document.getElementById("ask-form") as HTMLFormElement;
	const askInput = document.getElementById("ask-input") as HTMLInputElement;
	const askSend = document.getElementById("ask-send") as HTMLButtonElement;
	let ringAbort: AbortController | null = null;
	let askAbort: AbortController | null = null;
	let askLat = NaN;
	let askLng = NaN;
	let askBusy = false;
	const askTurns: { role: "user" | "assistant"; content: string }[] = [];
	let ringSeries: RingSeries | null = null;
	let calendarMode: CalendarMode = "count";
	let hideTimer = 0;
	let onHexOut: ((e: AnimationEvent) => void) | null = null;

	function clearHide() {
		window.clearTimeout(hideTimer);
		if (!onHexOut) return;
		for (const cell of hexCells) {
			cell.removeEventListener("animationend", onHexOut);
		}
		onHexOut = null;
	}

	const leaving = new Map<HTMLElement, () => void>();

	function isOpen(frame: HTMLElement) {
		return !frame.hidden && !frame.classList.contains("is-leaving");
	}

	function leaveFrame(frame: HTMLElement) {
		if (!isOpen(frame)) return;
		frame.classList.add("is-leaving");
		const cancel = () => {
			window.clearTimeout(timer);
			frame.removeEventListener("animationend", onEnd);
			frame.classList.remove("is-leaving");
			leaving.delete(frame);
		};
		const done = () => {
			cancel();
			frame.hidden = true;
		};
		const onEnd = (e: AnimationEvent) => {
			if (e.target === frame && e.animationName === "frame-out") done();
		};
		//fallback in case animationend never fires (tab hidden, display change)
		const timer = window.setTimeout(done, 450);
		frame.addEventListener("animationend", onEnd);
		leaving.set(frame, cancel);
	}

	function enterFrame(frame: HTMLElement) {
		leaving.get(frame)?.();
		frame.hidden = false;
	}

	function closeRingFrame() {
		clearRingTip(ringTip);
		leaveFrame(ringFrame);
	}

	function closeCalendarFrame() {
		clearRingTip(ringTip);
		leaveFrame(calendarFrame);
	}

	function closeRaceFrame() {
		clearRingTip(ringTip);
		leaveFrame(raceFrame);
	}

	function closeDriftFrame() {
		clearRingTip(ringTip);
		leaveFrame(driftFrame);
	}

	function closeSeamFrame() {
		clearRingTip(ringTip);
		leaveFrame(seamFrame);
	}

	function setAskBusy(busy: boolean) {
		askBusy = busy;
		askInput.disabled = busy || !Number.isFinite(askLat);
		askSend.disabled = askInput.disabled;
	}

	function addAskMessage(role: "user" | "assistant") {
		const row = document.createElement("div");
		row.className = `ask-row ask-row--${role}`;
		if (role === "assistant") {
			const avatar = document.createElement("span");
			avatar.className = "ask-avatar";
			avatar.setAttribute("aria-hidden", "true");
			row.append(avatar);
		}
		const msg = document.createElement("p");
		msg.className = `ask-msg ask-msg--${role}`;
		row.append(msg);
		askLog.append(row);
		return msg;
	}

	function renderReply(node: HTMLElement, text: string) {
		const safe = text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
		node.innerHTML = safe.replace(/\*\*(.+?)\*\*/g, "<b>$1</b>").replace(/^[*-] /gm, "• ");
	}

	function showAskError(node: HTMLElement, message: string) {
		node.classList.add("ask-msg--error");
		node.textContent = message;
	}

	function resetAsk() {
		askAbort?.abort();
		askAbort = null;
		askTurns.length = 0;
		setAskBusy(false);
		askLog.replaceChildren();
		const intro = document.createElement("div");
		intro.className = "ask-intro";
		intro.innerHTML = `<span class="ask-avatar ask-avatar--lg" aria-hidden="true"></span><h3>Ask about this place</h3><p>Questions are answered from the fire record within 100 miles, the same archive behind the charts.</p>`;
		askLog.append(intro);
		askSuggestions.hidden = false;
	}

	function closeAskFrame() {
		askAbort?.abort();
		askAbort = null;
		setAskBusy(false);
		leaveFrame(askFrame);
	}

	async function sendAsk(question: string) {
		const text = question.trim();
		if (askBusy || !text || !Number.isFinite(askLat) || !Number.isFinite(askLng)) return;
		askSuggestions.hidden = true;
		askLog.querySelector(".ask-intro")?.remove();
		askTurns.push({ role: "user", content: text });
		addAskMessage("user").textContent = text;
		const reply = addAskMessage("assistant");
		reply.innerHTML = `<span class="ask-dots" aria-label="Thinking"><i></i><i></i><i></i></span>`;
		askLog.scrollTop = askLog.scrollHeight;
		askInput.value = "";
		setAskBusy(true);
		const abort = new AbortController();
		askAbort = abort;
		try {
			const res = await fetch("/api/chat", {
				method: "POST",
				signal: abort.signal,
				headers: { "content-type": "application/json" },
				body: JSON.stringify({
					lat: askLat,
					lng: askLng,
					place: nameEl.textContent,
					messages: askTurns,
				}),
			});
			if (abort.signal.aborted) return;
			if (!res.ok || !res.body) {
				let message = "No answer came back.";
				try {
					const payload = (await res.json()) as { error?: string };
					if (payload.error) message = payload.error;
				} catch {
					/* keep the fallback */
				}
				showAskError(reply, message);
				return;
			}
			const reader = res.body.getReader();
			const decoder = new TextDecoder();
			let acc = "";
			while (true) {
				const { done, value } = await reader.read();
				if (done) break;
				acc += decoder.decode(value, { stream: true });
				if (!acc.trim()) continue;
				renderReply(reply, acc);
				askLog.scrollTop = askLog.scrollHeight;
			}
			if (!acc.trim()) {
				showAskError(reply, "No answer came back.");
				return;
			}
			askTurns.push({ role: "assistant", content: acc });
		} catch (err) {
			if ((err as Error).name === "AbortError") return;
			showAskError(reply, "No answer came back.");
		} finally {
			if (askAbort === abort) setAskBusy(false);
		}
	}

	function openAskFrame() {
		closeRingFrame();
		closeCalendarFrame();
		closeRaceFrame();
		closeDriftFrame();
		closeSeamFrame();
		if (!askLog.childElementCount) resetAsk();
		askTitle.textContent = nameEl.textContent || "Fire history";
		enterFrame(askFrame);
		askInput.focus();
	}

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	function countUp(root: HTMLElement) {
		if (reduceMotion.matches) return;
		for (const node of root.querySelectorAll<HTMLElement>("b")) {
			const match = node.textContent?.match(/^(\D*)(\d[\d,]*(?:\.\d+)?)([\s\S]*)$/);
			if (!match || /^(19|20)\d\d$/.test(match[2]) || /[A-Za-z]{3}\s*$/.test(match[1])) continue;
			const [, head, digits, tail] = match;
			const target = Number(digits.replace(/,/g, ""));
			if (!Number.isFinite(target) || target === 0) continue;
			const decimals = digits.split(".")[1]?.length ?? 0;
			const start = performance.now();
			const tick = (now: number) => {
				const t = Math.min(1, (now - start) / 900);
				const value = target * (1 - (1 - t) ** 3);
				const shown = value.toLocaleString("en-US", {
					minimumFractionDigits: decimals,
					maximumFractionDigits: decimals,
					useGrouping: digits.includes(","),
				});
				node.textContent = `${head}${shown}${tail}`;
				if (t < 1) requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		}
	}

	function paintRings() {
		clearRingTip(ringTip);
		if (!ringSeries) {
			ringLegend.replaceChildren();
			ringReadout.replaceChildren();
			ringHost.replaceChildren(ringHost.dataset.state === "error" ? "No record" : "…");
			return;
		}
		ringTitle.textContent = nameEl.textContent || "Fire history";
		drawRingChart(ringHost, ringSeries, ringTip, ringLegend, ringReadout);
		countUp(ringReadout);
	}

	function openRingFrame() {
		closeCalendarFrame();
		closeRaceFrame();
		closeDriftFrame();
		closeSeamFrame();
		closeAskFrame();
		enterFrame(ringFrame);
		paintRings();
		ringClose.focus();
	}

	function paintCalendar() {
		clearRingTip(ringTip);
		if (!ringSeries) {
			calendarLegend.replaceChildren();
			calendarTable.replaceChildren();
			calendarReadout.replaceChildren();
			calendarHost.replaceChildren(calendarHost.dataset.state === "error" ? "No record" : "…");
			return;
		}
		calendarTitle.textContent = nameEl.textContent || "Fire history";
		drawCalendar(calendarHost, ringSeries, ringTip, calendarLegend, calendarTable, calendarMode, calendarReadout);
		countUp(calendarReadout);
	}

	function openCalendarFrame() {
		closeRingFrame();
		closeRaceFrame();
		closeDriftFrame();
		closeSeamFrame();
		closeAskFrame();
		enterFrame(calendarFrame);
		paintCalendar();
		calendarClose.focus();
	}

	function paintRace() {
		clearRingTip(ringTip);
		if (!ringSeries) {
			raceLegend.replaceChildren();
			raceReadout.replaceChildren();
			raceHost.replaceChildren(raceHost.dataset.state === "error" ? "No record" : "…");
			return;
		}
		raceTitle.textContent = nameEl.textContent || "Fire history";
		drawRace(raceHost, ringSeries, ringTip, raceLegend, raceReadout);
		countUp(raceReadout);
	}

	function openRaceFrame() {
		closeRingFrame();
		closeCalendarFrame();
		closeDriftFrame();
		closeSeamFrame();
		closeAskFrame();
		enterFrame(raceFrame);
		paintRace();
		raceClose.focus();
	}

	function paintDrift() {
		clearRingTip(ringTip);
		if (!ringSeries) {
			driftLegend.replaceChildren();
			driftReadout.replaceChildren();
			driftHost.replaceChildren(driftHost.dataset.state === "error" ? "No record" : "…");
			return;
		}
		driftTitle.textContent = nameEl.textContent || "Fire history";
		drawDrift(driftHost, ringSeries, ringTip, driftLegend, driftReadout);
		countUp(driftReadout);
	}

	function openDriftFrame() {
		closeRingFrame();
		closeCalendarFrame();
		closeRaceFrame();
		closeSeamFrame();
		closeAskFrame();
		enterFrame(driftFrame);
		paintDrift();
		driftClose.focus();
	}

	function paintSeam() {
		clearRingTip(ringTip);
		if (!ringSeries) {
			seamLegend.replaceChildren();
			seamScatterLegend.replaceChildren();
			seamReadout.replaceChildren();
			const waiting = seamHost.dataset.state === "error" ? "No record" : "…";
			seamHost.replaceChildren(waiting);
			seamScatter.replaceChildren(waiting);
			return;
		}
		seamTitle.textContent = nameEl.textContent || "Fire history";
		drawSeam(seamHost, seamScatter, ringSeries, ringTip, seamLegend, seamScatterLegend, seamReadout);
		countUp(seamReadout);
	}

	function openSeamFrame() {
		closeRingFrame();
		closeCalendarFrame();
		closeRaceFrame();
		closeDriftFrame();
		closeAskFrame();
		enterFrame(seamFrame);
		paintSeam();
		seamClose.focus();
	}

	function finishHide() {
		clearHide();
		closeRingFrame();
		closeCalendarFrame();
		closeRaceFrame();
		closeDriftFrame();
		closeSeamFrame();
		closeAskFrame();
		hexPanel.hidden = true;
		hexPanel.classList.remove("is-out");
	}

	async function loadRings(lat: number, lng: number) {
		if (askLat !== lat || askLng !== lng) {
			askLat = lat;
			askLng = lng;
			resetAsk();
		}
		ringAbort?.abort();
		const abort = new AbortController();
		ringAbort = abort;
		ringSeries = null;
		ringHost.dataset.state = "loading";
		calendarHost.dataset.state = "loading";
		raceHost.dataset.state = "loading";
		driftHost.dataset.state = "loading";
		seamHost.dataset.state = "loading";
		seamScatter.dataset.state = "loading";
		if (isOpen(ringFrame)) paintRings();
		if (isOpen(calendarFrame)) paintCalendar();
		if (isOpen(raceFrame)) paintRace();
		if (isOpen(driftFrame)) paintDrift();
		if (isOpen(seamFrame)) paintSeam();
		try {
			const res = await fetch(`/api/hotspots/rings?lat=${lat}&lng=${lng}`, { signal: abort.signal });
			if (!res.ok) throw new Error(`rings ${res.status}`);
			const series = (await res.json()) as RingSeries;
			if (abort.signal.aborted) return;
			ringSeries = series;
			if (isOpen(ringFrame)) paintRings();
			if (isOpen(calendarFrame)) paintCalendar();
			if (isOpen(raceFrame)) paintRace();
			if (isOpen(driftFrame)) paintDrift();
			if (isOpen(seamFrame)) paintSeam();
		} catch (err) {
			if ((err as Error).name === "AbortError") return;
			ringHost.dataset.state = "error";
			calendarHost.dataset.state = "error";
			raceHost.dataset.state = "error";
			driftHost.dataset.state = "error";
			seamHost.dataset.state = "error";
			seamScatter.dataset.state = "error";
			if (isOpen(ringFrame)) paintRings();
			if (isOpen(calendarFrame)) paintCalendar();
			if (isOpen(raceFrame)) paintRace();
			if (isOpen(driftFrame)) paintDrift();
			if (isOpen(seamFrame)) paintSeam();
		}
	}

	function showHexPanel() {
		clearHide();
		hexPanel.classList.remove("is-settled", "is-out");
		hexPanel.hidden = false;
		//next frame so the enter animation actually runs
		requestAnimationFrame(() => {
			hexPanel.classList.add("is-in");
		});

		let finished = 0;
		const onEnd = (e: AnimationEvent) => {
			if (e.animationName !== "hex-in" || hexPanel.classList.contains("is-out")) return;
			finished += 1;
			if (finished < hexCells.length) return;
			hexPanel.classList.add("is-settled");
			for (const cell of hexCells) {
				cell.removeEventListener("animationend", onEnd);
			}
		};
		for (const cell of hexCells) {
			cell.addEventListener("animationend", onEnd);
		}
	}

	function hideHexPanel() {
		if (hexPanel.hidden || hexPanel.classList.contains("is-out")) return;
		hexPanel.classList.remove("is-in", "is-settled");
		hexPanel.classList.add("is-out");

		let finished = 0;
		onHexOut = (e: AnimationEvent) => {
			if (e.animationName !== "hex-out") return;
			finished += 1;
			if (finished < hexCells.length) return;
			finishHide();
		};
		for (const cell of hexCells) {
			cell.addEventListener("animationend", onHexOut);
		}
		//0.55s + stagger, added a little slack if animationend is missed
		hideTimer = window.setTimeout(finishHide, 900);
	}

	watchVignette((close) => {
		vignette.classList.toggle("is-close", close);
	});

	watchStatus((next) => {
		nameEl.textContent = next.text;
		resetBtn.hidden = !next.showReset;
		if (isOpen(askFrame)) askTitle.textContent = next.text || "Fire history";
	});

	watchHex((open) => {
		if (open) showHexPanel();
		else hideHexPanel();
	});

	window.addEventListener("map:location", (event) => {
		const detail = (event as CustomEvent<{ lat: number; lng: number }>).detail;
		if (!Number.isFinite(detail?.lat) || !Number.isFinite(detail?.lng)) return;
		void loadRings(detail.lat, detail.lng);
	});

	ringButton.addEventListener("click", openRingFrame);
	ringClose.addEventListener("click", closeRingFrame);
	ringFrame.addEventListener("click", (event) => {
		if (!ringCard.contains(event.target as Node)) closeRingFrame();
	});

	calendarButton.addEventListener("click", openCalendarFrame);
	raceButton.addEventListener("click", openRaceFrame);
	driftButton.addEventListener("click", openDriftFrame);
	seamButton.addEventListener("click", openSeamFrame);
	raceClose.addEventListener("click", closeRaceFrame);
	raceFrame.addEventListener("click", (event) => {
		if (!raceCard.contains(event.target as Node)) closeRaceFrame();
	});
	driftClose.addEventListener("click", closeDriftFrame);
	driftFrame.addEventListener("click", (event) => {
		if (!driftCard.contains(event.target as Node)) closeDriftFrame();
	});
	seamClose.addEventListener("click", closeSeamFrame);
	seamFrame.addEventListener("click", (event) => {
		if (!seamCard.contains(event.target as Node)) closeSeamFrame();
	});
	askButton.addEventListener("click", openAskFrame);
	askClose.addEventListener("click", closeAskFrame);
	askFrame.addEventListener("click", (event) => {
		if (!askCard.contains(event.target as Node)) closeAskFrame();
	});
	askForm.addEventListener("submit", (event) => {
		event.preventDefault();
		void sendAsk(askInput.value);
	});
	askSuggestions.addEventListener("click", (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-ask]");
		if (!button?.dataset.ask) return;
		void sendAsk(button.dataset.ask);
	});
	calendarClose.addEventListener("click", closeCalendarFrame);
	calendarFrame.addEventListener("click", (event) => {
		if (!calendarCard.contains(event.target as Node)) closeCalendarFrame();
	});
	for (const button of calendarModes) {
		button.addEventListener("click", () => {
			calendarMode = button.dataset.mode === "departure" ? "departure" : "count";
			for (const other of calendarModes) {
				other.setAttribute("aria-pressed", String(other === button));
			}
			if (ringSeries) paintCalendar();
		});
	}

	resetBtn.addEventListener("click", requestReset);
	window.addEventListener("keydown", (e) => {
		if (e.key !== "Escape") return;
		if (isOpen(askFrame)) {
			closeAskFrame();
			return;
		}
		if (isOpen(seamFrame)) {
			closeSeamFrame();
			return;
		}
		if (isOpen(driftFrame)) {
			closeDriftFrame();
			return;
		}
		if (isOpen(raceFrame)) {
			closeRaceFrame();
			return;
		}
		if (isOpen(calendarFrame)) {
			closeCalendarFrame();
			return;
		}
		if (isOpen(ringFrame)) {
			closeRingFrame();
			return;
		}
		requestReset();
	});
</script>
