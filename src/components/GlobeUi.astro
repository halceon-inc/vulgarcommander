	}

	.ask-avatar--lg {
		animation: hex-float 3.2s ease-in-out infinite;
	}

	.ask-row--assistant:has(.ask-dots) .ask-avatar::after {
		animation: core-pulse 0.9s ease-in-out infinite;
	}

	.ask-form button:not(:disabled) svg {
		transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.ask-form button:hover:not(:disabled) svg {
		transform: translateY(-2px);
	}

	/* chart draw-ins */
	.race-line.now,
	.race-line.analog,
	.seam-line,
	.seam-fit {
		stroke-dasharray: 1;
		animation: draw 1.2s cubic-bezier(0.45, 0, 0.2, 1) both;
	}

	.race-line.analog {
		animation-duration: 1s;
		animation-delay: 0.1s;
	}

	.race-line.now {
		animation-delay: 0.25s;
	}

	.race-band,
	.race-line.med {
		animation: fade 0.7s ease both;
	}

	.race-band.b1 {
		animation-delay: 0.08s;
	}

	.race-band.b2 {
		animation-delay: 0.16s;
	}

	.race-dot {
		transform-box: fill-box;
		transform-origin: center;
		animation: pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 1.35s both;
	}

	.race-label.ink {
		animation: fade 0.4s ease 1.4s both;
	}

	.seam-line {
		animation-delay: 0.15s;
	}

	.seam-era,
	.seam-mark {
		animation: fade 0.6s ease 0.1s both;
	}

	.seam-area {
		animation: fade 0.8s ease 0.6s both;
	}

	.seam-dot,
	.seam-pt {
		transform-box: fill-box;
		transform-origin: center;
		animation: pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}

	.seam-dot {
		animation-delay: calc(0.2s + var(--i) * 40ms);
	}

	.seam-pt {
		animation-delay: calc(0.15s + var(--i) * 14ms);
	}

	.seam-fit {
		animation-delay: 0.9s;
	}

	.seam-level {
		animation: fade 0.5s ease 1.1s both;
	}

	.seam-sat {
		transform-box: fill-box;
		transform-origin: left center;
		animation: grow-x 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(0.3s + var(--i) * 80ms);
	}

	.drift-bar {
		transform-box: fill-box;
		transform-origin: center;
		animation: grow-x 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(var(--i) * 25ms);
	}

	.drift-tick {
		animation: fade 0.3s ease both;
		animation-delay: calc(0.35s + var(--i) * 25ms);
	}

	.drift-trend {
