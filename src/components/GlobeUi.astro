	/* ---------- motion ---------- */

	@property --hex-angle {
		syntax: "<angle>";
		initial-value: 0deg;
		inherits: false;
	}

	.chart-card > * {
		animation: rise 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.chart-card > :nth-child(2) {
