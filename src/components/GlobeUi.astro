		appearance: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		width: 100%;
		margin: 0;
		padding: 0.6rem 0.75rem 0.6rem 0.85rem;
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.025);
		color: #cfd8dc;
		font: 500 13.5px/1.3 ui-sans-serif, system-ui, sans-serif;
