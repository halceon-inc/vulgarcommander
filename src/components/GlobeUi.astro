	/* hex menu: sheen when settled, spinning edge and icon tricks on hover */
	.hex-cell::after {
		content: "";
		position: absolute;
		inset: 0;
		clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
