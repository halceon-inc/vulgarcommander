	.ask-form {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.75rem;
		padding: 0.3rem 0.3rem 0.3rem 1rem;
		background: #10161b;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}

	.ask-form:focus-within {
		border-color: rgba(217, 89, 38, 0.6);
		box-shadow: 0 0 0 3px rgba(217, 89, 38, 0.15);
	}

	.ask-form input {
		flex: 1;
		min-width: 0;
		padding: 0.45rem 0;
		border: 0;
		background: transparent;
		color: #e8edef;
		font: 450 14.5px/1.3 ui-sans-serif, system-ui, sans-serif;
		outline: none;
	}

	.ask-form input::placeholder {
		color: #5d6b73;
	}

	.ask-form button {
		appearance: none;
		display: grid;
		place-items: center;
		flex: none;
		width: 34px;
		height: 34px;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: #d95926;
		color: #fff;
		cursor: pointer;
		transition:
			background 0.15s ease,
			transform 0.15s ease,
			opacity 0.15s ease;
	}

	.ask-form button svg {
		width: 15px;
		height: 15px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.ask-form button:hover:not(:disabled) {
		background: #e8692f;
		transform: scale(1.05);
	}

	.ask-form button:disabled {
		background: #3e4b53;
		color: #84939c;
		cursor: default;
	}

	.ask-form input:disabled {
		cursor: default;
	}

	.ask-foot {
		margin: 0.55rem 0 0;
		color: #5d6b73;
		font: 450 11.5px/1.4 ui-sans-serif, system-ui, sans-serif;
		text-align: center;
	}

	@keyframes ask-in {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
	}

	@keyframes ask-dot {
		0%,
		80%,
		100% {
			opacity: 0.3;
			transform: translateY(0);
		}
		40% {
			opacity: 1;
			transform: translateY(-3px);
		}
	}

	@keyframes card-in {
		from {
			opacity: 0;
			transform: translateY(10px) scale(0.985);
		}
	}

	@keyframes frame-out {
		to {
			opacity: 0;
		}
	}

	@keyframes card-out {
		to {
			opacity: 0;
			transform: translateY(12px) scale(0.96);
			filter: blur(3px);
		}
	}

	/* ---------- motion ---------- */

	@property --hex-angle {
		syntax: "<angle>";
		initial-value: 0deg;
		inherits: false;
	}

	.chart-card > * {
		animation: rise 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.chart-card > :nth-child(2) {
		animation-delay: 0.06s;
	}

	.chart-card > :nth-child(3) {
		animation-delay: 0.12s;
	}

	.chart-card > :nth-child(4) {
