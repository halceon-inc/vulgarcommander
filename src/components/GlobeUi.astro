	.ask-suggestions svg {
		flex: none;
		width: 14px;
		height: 14px;
		fill: none;
		stroke: #5d6b73;
		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition:
			stroke 0.15s ease,
			transform 0.15s ease;
