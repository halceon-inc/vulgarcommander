		animation: card-in 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.chart-card--ring {
		width: min(720px, 100%);
	}

	.chart-card--calendar {
		width: min(1040px, 100%);
	}

	.chart-card--wide {
		width: min(1180px, 100%);
	}

	.chart-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.8rem;
	}

	.chart-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		color: #84939c;
		font: 500 11px/1 ui-monospace, Menlo, Consolas, monospace;
