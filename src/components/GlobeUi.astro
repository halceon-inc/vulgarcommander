<style is:global>
	#globe-vignette {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		background: radial-gradient(
			ellipse 72% 66% at 50% 48%,
			transparent 58%,
			rgba(2, 4, 12, 0.22) 78%,
			rgba(2, 4, 12, 0.76) 100%
		);
		transition: opacity 0.6s ease;
	}

	#globe-vignette.is-close {
		opacity: 0.28;
	}

	.globe-pin {
		width: 28px;
		height: 42px;
		visibility: hidden;
		cursor: grab;
		filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.45));
	}

	#globe .globe-pin {
		visibility: visible;
	}

	.globe-pin svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.globe-pin path {
		fill: #e85d4c;
		stroke: #fff;
		stroke-width: 1.25;
		paint-order: stroke fill;
	}

	.globe-pin circle {
		fill: #fff;
	}

	#location-hud {
		position: fixed;
		z-index: 10;
		left: 1.1rem;
		bottom: 1.1rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.55rem 0.6rem 0.55rem 0.95rem;
		background: rgba(6, 10, 20, 0.58);
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(14px);
		font: 500 13px/1.2 ui-sans-serif, system-ui, sans-serif;
		letter-spacing: 0.03em;
	}

	#location-name {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	#location-name::before {
		content: "";
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #d95926;
		box-shadow: 0 0 0 3px rgba(217, 89, 38, 0.18);
	}

	#globe-reset {
		appearance: none;
		margin: 0;
		padding: 0.35rem 0.7rem;
		border: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.1);
		color: inherit;
		font: inherit;
		letter-spacing: 0.04em;
		cursor: pointer;
	}

	#globe-reset:hover {
		background: rgba(255, 255, 255, 0.18);
	}

	/* honeycomb thing on the globe */
	#hex-panel {
		/* --hex-size is the vertex-to-vertex height */
		--hex-size: min(26vmin, 32vmax);
		--hex-gap: 1.22;
		position: fixed;
		inset: 0;
		z-index: 8;
		display: grid;
		place-items: center;
		pointer-events: none;
	}

	#hex-panel.is-out .hex-cell {
		pointer-events: none;
		animation: hex-out 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(var(--i) * 45ms);
	}

	#hex-panel[hidden] {
		display: none;
	}

	.hex-grid {
		position: relative;
		width: calc(var(--hex-size) * 2.85 * var(--hex-gap));
		height: calc(var(--hex-size) * 3.1 * var(--hex-gap));
		pointer-events: none;
	}

	.hex-cell {
		/* pointy-top axial to pixel */
		--x: calc(
			(var(--q) + var(--r) * 0.5) * var(--hex-size) * 0.8660254 * var(--hex-gap)
		);
		--y: calc(var(--r) * 0.75 * var(--hex-size) * var(--hex-gap));
		--i: 0;
		appearance: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		font: 600 clamp(12px, calc(var(--hex-size) * 0.072), 16px) / 1 ui-sans-serif, system-ui, sans-serif;
		letter-spacing: 0.01em;
		position: absolute;
		left: 50%;
		top: 50%;
		isolation: isolate;
		width: calc(var(--hex-size) * 0.8660254);
		height: var(--hex-size);
		margin: 0;
		padding: 0;
		border: 0;
		/* the outer hex is the border, ::before is the fill */
		background: rgba(255, 255, 255, 0.16);
		color: #e8edef;
		cursor: pointer;
		pointer-events: auto;
		clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
		opacity: 0;
		transform: translate(-50%, -50%) translate(var(--x), var(--y)) scale(0.55);
		transition: background 0.18s ease;
	}

	.hex-cell::before {
		content: "";
		position: absolute;
		inset: 1.5px;
		z-index: -1;
		clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
		background: linear-gradient(165deg, rgba(30, 39, 46, 0.94), rgba(12, 17, 22, 0.94));
		transition: background 0.18s ease;
	}

	.hex-cell svg {
		width: 30%;
		max-width: 36px;
		margin-bottom: 0.15rem;
		fill: none;
		stroke: #84939c;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: stroke 0.18s ease;
	}

	.hex-sub {
		color: #84939c;
		font: 500 clamp(9px, calc(var(--hex-size) * 0.048), 10.5px) / 1 ui-monospace, Menlo, Consolas, monospace;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.hex-cell.is-empty {
		background: rgba(255, 255, 255, 0.07);
		cursor: default;
		pointer-events: none;
	}

	.hex-cell.is-empty::before {
		background: rgba(10, 14, 18, 0.45);
	}

	.hex-cell:nth-child(1) {
		--i: 0;
	}
	.hex-cell:nth-child(2) {
		--i: 1;
	}
	.hex-cell:nth-child(3) {
		--i: 2;
	}
	.hex-cell:nth-child(4) {
		--i: 3;
	}
	.hex-cell:nth-child(5) {
		--i: 4;
	}
	.hex-cell:nth-child(6) {
		--i: 5;
	}

	#hex-panel.is-in .hex-cell {
		animation: hex-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(var(--i) * 70ms);
	}

	/* lock final the pose so hover doesn't restart the enter animation */
	#hex-panel.is-settled .hex-cell {
		animation: none;
		opacity: 1;
		transform: translate(-50%, -50%) translate(var(--x), var(--y)) scale(1);
		transition:
			background 0.18s ease,
			transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
	}

	#hex-panel.is-settled .hex-cell:not(.is-empty):hover,
	#hex-panel.is-settled .hex-cell:not(.is-empty):focus-visible {
		background: #d95926;
		outline: none;
		transform: translate(-50%, -50%) translate(var(--x), var(--y)) scale(1.05);
	}

	#hex-panel.is-settled .hex-cell:not(.is-empty):hover::before,
	#hex-panel.is-settled .hex-cell:not(.is-empty):focus-visible::before {
		background: linear-gradient(165deg, rgba(52, 36, 28, 0.96), rgba(20, 16, 14, 0.96));
	}

	#hex-panel.is-settled .hex-cell:hover svg,
	#hex-panel.is-settled .hex-cell:focus-visible svg {
		stroke: #ef8d58;
	}

	.chart-frame {
		position: fixed;
		inset: 0;
		z-index: 12;
		display: grid;
		place-items: center;
		padding: 1.25rem;
		background: radial-gradient(ellipse at 50% 40%, rgba(2, 4, 12, 0.45), rgba(2, 4, 12, 0.72));
		backdrop-filter: blur(3px);
		animation: frame-in 0.22s ease both;
	}

	.chart-frame[hidden] {
		display: none;
	}

	.chart-frame.is-leaving {
		animation: frame-out 0.24s ease 0.04s both;
		pointer-events: none;
	}

	.chart-frame.is-leaving .chart-card {
		animation: card-out 0.22s cubic-bezier(0.4, 0, 1, 1) both;
	}

	.chart-card {
		width: min(920px, 100%);
		max-height: calc(100dvh - 2.5rem);
		overflow: auto;
		padding: 1.15rem 1.3rem 1.1rem;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent 7rem),
			rgba(14, 19, 24, 0.95);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 18px;
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.06) inset,
			0 28px 90px rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(16px);
		color: #e8edef;
		scrollbar-width: thin;
		scrollbar-color: #3e4b53 transparent;
		animation: card-in 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.chart-card--ring {
		width: min(720px, 100%);
	}

	.chart-card--calendar {
		width: min(1040px, 100%);
	}

	.chart-card--wide {
		width: min(1180px, 100%);
	}

	.chart-card--ask {
		width: min(640px, 100%);
		display: flex;
		flex-direction: column;
		max-height: min(720px, calc(100dvh - 2.5rem));
		overflow: hidden;
	}

	.chart-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.8rem;
	}

	.chart-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		color: #84939c;
		font: 500 11px/1 ui-monospace, Menlo, Consolas, monospace;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.chart-eyebrow::before {
		content: "";
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #d95926;
		box-shadow: 0 0 0 3px rgba(217, 89, 38, 0.18);
	}

	.chart-head h2 {
		margin: 0.45rem 0 0;
		font: 650 24px/1.1 ui-sans-serif, system-ui, sans-serif;
		letter-spacing: -0.015em;
	}

	.chart-actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.chart-close {
		appearance: none;
		display: grid;
		place-items: center;
		flex: none;
		width: 32px;
		height: 32px;
		margin: 0;
		padding: 0;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.06);
		color: #b3bfc6;
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.chart-close svg {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
	}

	.chart-close:hover,
	.chart-close:focus-visible {
		background: rgba(255, 255, 255, 0.14);
		border-color: rgba(255, 255, 255, 0.22);
		color: #fff;
		outline: none;
	}

	.chart-panel {
