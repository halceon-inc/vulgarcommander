	#hex-panel.is-settled [data-graph="drift"]:hover path:nth-child(2) {
		animation: icon-drift 0.9s ease-in-out infinite alternate;
	}

	#hex-panel.is-settled [data-graph="ask"]:hover .dot {
		animation: icon-bounce 0.9s ease-in-out infinite;
	}

	#hex-panel.is-settled [data-graph="ask"]:hover .dot:nth-of-type(3) {
		animation-delay: 0.12s;
	}

	#hex-panel.is-settled [data-graph="ask"]:hover .dot:nth-of-type(4) {
		animation-delay: 0.24s;
	}

	/* ask */
	.ask-suggestions button {
		animation: rise 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.ask-suggestions button:nth-of-type(1) {
		animation-delay: 0.2s;
